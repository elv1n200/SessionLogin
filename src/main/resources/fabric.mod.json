{
	"schemaVersion": 1,
	"id": "sessionlogin",
	"version": "${version}",
	"name": "Session Login",
	"description": "Token-based Minecraft session switcher with a saved multi-account manager. No email/password auth, no telemetry; tokens are used only against official Mojang APIs.",
	"authors": [
		"elv1n200"
	],
	"contact": {
		"homepage": "None",
		"sources": "https://github.com/elv1n200/SessionLogin"
	},
	"license": "CC0-1.0",
	"icon": "assets/sessionlogin/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.elv1n200.sessionlogin.SessionLogin"
		],
		"client": [
			"dev.elv1n200.sessionlogin.SessionLoginClient"
		]
	},
	"mixins": [
		"sessionlogin.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
