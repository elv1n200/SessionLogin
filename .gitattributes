# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Java / Kotlin / Gradle / JSON / Markdown / YAML stay LF on disk too.
*.java         text eol=lf
*.kt           text eol=lf
*.gradle       text eol=lf
*.gradle.kts   text eol=lf
*.kts          text eol=lf
*.properties   text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.xml          text eol=lf
.editorconfig  text eol=lf

# Unix shell entry point.
gradlew        text eol=lf

# Windows scripts stay CRLF.
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binary assets — Git should not touch.
*.jar          binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.zip          binary
